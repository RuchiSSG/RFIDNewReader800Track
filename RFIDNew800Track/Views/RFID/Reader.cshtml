<button id="stopButton" type="button" class="btn btn-danger" disabled>Stop and Save</button>
<button id="startButton" type="button" class="btn btn-success" disabled>Start</button>
<button id="clearButton" type="button" class="btn btn-warning" disabled>Clear Data</button>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        let pollingTimeout = null;
        let isRunning = false;
        let previousTagIds = [];

        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "5000"
        };

        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    toastr.success('@TempData["SuccessMessage"]');
                </text>
        }

        // ==========================================
        // PAGE LOAD
        // ==========================================

        $(document).ready(function () {

            restoreRaceState();

            $('#groupId').change(function () {

                let groupId = $(this).val();

                localStorage.setItem("selectedGroup", groupId);

                if (groupId) {

                    loadChestRFID(groupId);

                    $('#startButton').prop('disabled', false);

                } else {

                    $('#startButton').prop('disabled', true);
                }
            });

            // START
            $('#startButton').click(startRace);

            // STOP
            $('#stopButton').click(stopRace);

            // CLEAR
            $('#clearButton').click(clearAllTables);

            // RESET
            $('#resetButton').click(resetSystem);

            // LOGOUT
            $('#logoutButton').click(logoutSystem);

        });

        // ==========================================
        // RESTORE STATE
        // ==========================================

        function restoreRaceState() {

            let savedGroup = localStorage.getItem("selectedGroup");

            if (savedGroup) {

                $('#groupId').val(savedGroup);

                loadChestRFID(savedGroup);
                    // ✅ Restore RFID Table
        restoreRfidTable();
            }

            let raceRunning = localStorage.getItem("raceRunning");

            if (raceRunning === "true") {

                isRunning = true;

                $('#startButton').prop('disabled', true);
                $('#stopButton').prop('disabled', false);

                updateRfidData();
            }
        }

        // ==========================================
        // LOAD CHEST RFID
        // ==========================================

        function loadChestRFID(groupId) {

            $.get('/RFID/GetChestRFIDByGroup', { groupId: groupId })

                .done(function (data) {

                    let tbody = $('#chestTable tbody');

                    tbody.empty();

                    if (!data || data.length === 0) {

                        tbody.append('<tr><td colspan="5">No Data</td></tr>');
                        return;
                    }

                    data.forEach(item => {

                        tbody.append(`
                            <tr data-rfid="${item.tagId}">
                                <td>${item.chestNo}</td>
                                <td>${item.tagId}</td>
                                <td>${item.barcode}</td>
                                <td class="lap-count text-muted">0</td>
                                <td class="live-time text-muted">Waiting...</td>
                            </tr>
                        `);
                                // ✅ RESTORE SAVED RFID DATA
        let saved = localStorage.getItem(
            "rfidLiveData_" + item.tagId.trim()
        );

        if (saved) {

            let parsed = JSON.parse(saved);

            // ✅ Restore Lap Count
            $(`#chestTable tr[data-rfid='${item.tagId}']`)
                .find('.lap-count')
                .removeClass('text-muted')
                .addClass('fw-bold')
                .text(parsed.lapCount);

            // ✅ Restore Time
            let html = "";

            const eventName = $("#eventName").val();

            const singleLapEvents = [
                "100 Meter Running",
                "800 Meter Running",
                "1600 Meter Running"
            ];

            const isSingleRace =
                singleLapEvents.includes(eventName);

            if (isSingleRace) {

                html = `
                    <div class="fw-bold text-success">
                        ${parsed.lapTimes[
                            parsed.lapTimes.length - 1
                        ]}
                    </div>
                `;

            } else {

                html = parsed.lapTimes.map((t, i) => `
                    <div class="fw-bold text-success">
                        Lap ${i + 1}: ${t}
                    </div>
                `).join('');
            }

            $(`#chestTable tr[data-rfid='${item.tagId}']`)
                .find('.live-time')
                .html(html);
        }
                    });
                });
        }

        // ==========================================
        // START RACE
        // ==========================================

        function startRace() {

            $.post('@Url.Action("ClearData", "RFID")', function () {

                $.post('@Url.Action("StartRace", "RFID")', function () {

                    isRunning = true;

                    localStorage.setItem("raceRunning", "true");

                    $('#rfidDataBody').empty();

                    $('#debugInfo').text('Race Started...');

                    $('#startButton').prop('disabled', true);

                    $('#stopButton').prop('disabled', false);

                    $('#clearButton').prop('disabled', true);

                    updateRfidData();
                });
            });
        }

        // ==========================================
        // LIVE RFID UPDATE
        // ==========================================

        function updateRfidData() {

            if (!isRunning) return;

            $.ajax({

                url: '@Url.Action("GetData", "RFID")',
                type: 'GET',
                cache: false,
                dataType: 'json',

                success: function (response) {

                    if (response && response.rfidDataArray) {

                        updateTable(response.rfidDataArray);

                        $('#debugInfo').text(
                            'Live RFID Running... ' +
                            new Date().toLocaleTimeString()
                        );
                    }
                },

                complete: function () {

                    if (isRunning) {

                        pollingTimeout = setTimeout(updateRfidData, 150);
                    }
                }
            });
        }

        // ==========================================
        // UPDATE TABLE
        // ==========================================

        function updateTable(data) {

            if (!data || data.length === 0) return;

            const eventName = $("#eventName").val();

            const singleLapEvents = [
                "100 Meter Running",
                "800 Meter Running",
                "1600 Meter Running"
            ];

            const isSingleRace =
                singleLapEvents.includes(eventName);

            data.forEach(item => {

                let lapTimes = item.lapTimes || [];

                let lapCount = lapTimes.length;
                        // ✅ SAVE LIVE RFID DATA
        localStorage.setItem(
            "rfidLiveData_" + item.tagId.trim(),
            JSON.stringify({
                lapCount: lapCount,
                lapTimes: lapTimes
            })
        );
                let $row = $(`#rfidDataBody tr[data-rfid='${item.tagId}']`);

                if ($row.length === 0) {

                    $('#rfidDataBody').append(`
                        <tr data-rfid="${item.tagId}">
                            <td class="sr-no"></td>
                            <td>${item.tagId}</td>
                            <td class="lap-count"></td>
                            <td class="time-cell"></td>
                        </tr>
                    `);

                    $row = $(`#rfidDataBody tr[data-rfid='${item.tagId}']`);
                }

                if (!isSingleRace) {

                    $row.find('.lap-count').text(lapCount);
                }

                let timeHtml = "";

                if (isSingleRace) {

                    timeHtml =
                        `<div class="fw-bold text-success">
                            ${lapTimes[lapTimes.length - 1]}
                        </div>`;

                } else {

                    timeHtml = lapTimes.map((t, i) =>
                        `<div>Lap ${i + 1}: ${t}</div>`
                    ).join('');
                }

                $row.find('.time-cell').html(timeHtml);

                updateChestTable(item, isSingleRace);
            });

            updateSerialNumbers();
        }

        // ==========================================
        // UPDATE CHEST TABLE
        // ==========================================

        function updateChestTable(item, isSingleRace) {

            const $row =
                $(`#chestTable tr[data-rfid='${item.tagId}']`);

            if (!$row.length) return;

            let lapTimes = item.lapTimes || [];

            let lapCount = lapTimes.length;

            if (!isSingleRace) {

                $row.find('.lap-count')
                    .removeClass('text-muted')
                    .addClass('fw-bold')
                    .text(lapCount);
            }

            let html = "";

            if (isSingleRace) {

                html = `
                    <div class="fw-bold text-success">
                        ${lapTimes[lapTimes.length - 1]}
                    </div>
                `;

            } else {

                html = lapTimes.map((t, i) =>
                    `<div class="fw-bold text-success">
                        Lap ${i + 1}: ${t}
                    </div>`
                ).join('');
            }

            $row.find('.live-time').html(html);
        }

        // ==========================================
        // SERIAL NUMBERS
        // ==========================================

        function updateSerialNumbers() {

            $('#rfidDataBody tr').each(function (index) {

                $(this).find('.sr-no').text(index + 1);
            });
        }
                // ==========================================
        // RESTORE RFID TABLE
        // ==========================================

        function restoreRfidTable() {

            $('#rfidDataBody').empty();

            let srNo = 1;

            Object.keys(localStorage).forEach(key => {

                if (key.startsWith("rfidLiveData_")) {

                    let tagId = key.replace("rfidLiveData_", "");

                    let data = JSON.parse(localStorage.getItem(key));

                    let lapTimes = data.lapTimes || [];

                    let lapCount = data.lapCount || 0;

                    let eventName = $("#eventName").val();

                    const singleLapEvents = [
                        "100 Meter Running",
                        "800 Meter Running",
                        "1600 Meter Running"
                    ];

                    const isSingleRace =
                        singleLapEvents.includes(eventName);

                    let timeHtml = "";

                    if (isSingleRace) {

                        timeHtml = `
                            <div class="fw-bold text-success">
                                ${lapTimes[lapTimes.length - 1] || ''}
                            </div>
                        `;

                    } else {

                        timeHtml = lapTimes.map((t, i) => `
                            <div>
                                Lap ${i + 1}: ${t}
                            </div>
                        `).join('');
                    }

                    $('#rfidDataBody').append(`
                        <tr data-rfid="${tagId}">
                            <td class="sr-no">${srNo}</td>
                            <td>${tagId}</td>
                            <td class="lap-count">
                                ${isSingleRace ? '' : lapCount}
                            </td>
                            <td class="time-cell">
                                ${timeHtml}
                            </td>
                        </tr>
                    `);

                    srNo++;
                }
            });
        }
        // ==========================================
        // STOP RACE
        // ==========================================

        function stopRace() {

            Swal.fire({

                title: 'Stop Race?',
                text: 'Race will stop and save data.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes'

            }).then((result) => {

                if (!result.isConfirmed) return;

                $.post('@Url.Action("Stop", "RFID")', function (response) {

                    if (response.success) {

                        isRunning = false;

                        clearTimeout(pollingTimeout);

                        localStorage.removeItem("raceRunning");
                                // ✅ CLEAR RFID LIVE STORAGE
        Object.keys(localStorage).forEach(key => {

            if (key.startsWith("rfidLiveData_")) {

                localStorage.removeItem(key);
            }
        });
                        renderFinalResult(response.result);

                        $('#startButton').prop('disabled', false);

                        $('#stopButton').prop('disabled', true);

                        $('#clearButton').prop('disabled', false);

                        Swal.fire(
                            'Saved!',
                            'Race stopped successfully.',
                            'success'
                        );
                    }
                });
            });
        }

        // ==========================================
        // FINAL RESULT
        // ==========================================

        function renderFinalResult(data) {

            let body = $('#finalResultBody');

            body.empty();

            if (!data || data.length === 0) {

                body.append('<tr><td colspan="6">No Data</td></tr>');
                return;
            }

            let sr = 1;

            data.forEach(item => {

                body.append(`
                    <tr>
                        <td>${sr}</td>
                        <td>${item.barcode || '-'}</td>
                        <td>${item.chestNo || '-'}</td>
                        <td>${item.tagId || '-'}</td>
                        <td>${item.position || '-'}</td>
                        <td>${item.finalTime || '-'}</td>
                    </tr>
                `);

                sr++;
            });
        }

        // ==========================================
        // CLEAR TABLES
        // ==========================================

        function clearAllTables() {

            $('#rfidDataBody').html(
                '<tr><td colspan="4">No data available</td></tr>'
            );

            $('#finalResultBody').html(
                '<tr><td colspan="6">Data will appear here after Stop</td></tr>'
            );

            $('#debugInfo').text('All tables cleared');
                    // ✅ CLEAR SAVED RFID DATA
        Object.keys(localStorage).forEach(key => {

            if (key.startsWith("rfidLiveData_")) {

                localStorage.removeItem(key);
            }
        });
        }

        // ==========================================
        // RESET
        // ==========================================

        function resetSystem() {

            Swal.fire({

                title: 'Reset?',
                icon: 'warning',
                showCancelButton: true

            }).then((result) => {

                if (!result.isConfirmed) return;

                $.post('@Url.Action("Reset", "RFID")', function (response) {

                    if (response.success) {

                        Swal.fire(
                            'Success',
                            'Reset Successful',
                            'success'
                        ).then(() => {

                            window.location.href =
                                '@Url.Action("Configuration", "RFID")';
                        });
                    }
                });
            });
        }

        // ==========================================
        // LOGOUT
        // ==========================================

        function logoutSystem() {

            Swal.fire({

                title: 'Logout?',
                icon: 'warning',
                showCancelButton: true

            }).then((result) => {

                if (!result.isConfirmed) return;

              
                        $('#rfidDataBody').empty();

        $('#chestTable tbody').empty();

        $('#finalResultBody').empty();
          localStorage.clear();

                sessionStorage.clear();
                window.location.href =
                    '@Url.Action("Login", "Account")';
            });
        }

        // ==========================================
        // PRINT
        // ==========================================

        function printPage() {

            window.print();
        }

    </script>
}